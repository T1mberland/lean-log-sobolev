import Mathlib.Analysis.Calculus.Deriv.Comp
import LogSobolev.Unitary.SpecialUnitaryAlgebra
import Mathlib.Analysis.Calculus.Deriv.Star
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-! # Velocities of curves in the matrix unitary group

This provides a direct link between actual matrix-group curves and
skew-Hermitian matrices, before constructing a manifold atlas. The exponential
realizes every skew-Hermitian matrix as a velocity at the identity. Trace-zero
and determinant-one constraints require an additional argument for SU.
-/

open Matrix
open scoped Matrix.Norms.Frobenius

namespace LogSobolev

variable {n : Type*} [Fintype n] [DecidableEq n]

omit [DecidableEq n] in
/-- Extract scalar entry derivatives from a Frobenius matrix derivative. -/
theorem hasDerivAt_matrix_entry {γ : ℝ → Matrix n n ℂ} {A : Matrix n n ℂ} {x : ℝ}
    (h : HasDerivAt γ A x) (i j : n) :
    HasDerivAt (fun t => γ t i j) (A i j) x := by
  exact (LinearMap.toContinuousLinearMap (Matrix.entryLinearMap ℝ ℂ i j)).hasFDerivAt.comp_hasDerivAt x h

/-- Differentiating the unitary constraint at the identity gives a
skew-Hermitian velocity, in the Frobenius norm topology. -/
theorem unitary_curve_derivative_skew
    (γ : ℝ → Matrix.unitaryGroup n ℂ) {x : ℝ} {A : Matrix n n ℂ}
    (hγ : HasDerivAt (fun t => (γ t).val) A x) (hx : γ x = 1) :
    star A = -A := by
  have hd := hγ.star.mul hγ
  have he : (fun t => star (γ t).val * (γ t).val) = fun _ => (1 : Matrix n n ℂ) :=
    funext fun t => (γ t).prop.1
  change HasDerivAt (fun t => star (γ t).val * (γ t).val) _ x at hd
  rw [he] at hd
  have hz := hd.unique (hasDerivAt_const x (1 : Matrix n n ℂ))
  have ha : star A + A = 0 := by simpa [hx] using hz
  exact eq_neg_of_add_eq_zero_left ha

/-- The canonical unitary exponential curve generated by a skew-Hermitian
matrix; this definition makes no determinant-one assertion. -/
noncomputable def unitaryExpCurve (A : Matrix n n ℂ) (hA : star A = -A)
    (t : ℝ) : Matrix.unitaryGroup n ℂ :=
  ⟨NormedSpace.exp (t • A), NormedSpace.exp_mem_unitary_of_mem_skewAdjoint (by
    change star (t • A) = -(t • A)
    simp [star_smul, hA])⟩

@[simp] theorem unitaryExpCurve_zero (A : Matrix n n ℂ) (hA : star A = -A) :
    unitaryExpCurve A hA 0 = 1 := by
  apply Subtype.ext
  simp [unitaryExpCurve]

/-- Every skew-Hermitian matrix is realized as an actual unitary curve velocity. -/
theorem unitaryExpCurve_hasDerivAt_zero (A : Matrix n n ℂ) (hA : star A = -A) :
    HasDerivAt (fun t => (unitaryExpCurve A hA t).val) A 0 := by
  simpa [unitaryExpCurve] using hasDerivAt_exp_smul_const A (0 : ℝ)

/-- A characterization by actual differentiable curves, not a definition of
tangent vectors by an assumed skew-Hermitian condition. -/
theorem skewAdjoint_iff_unitary_curve_velocity (A : Matrix n n ℂ) :
    star A = -A ↔ ∃ γ : ℝ → Matrix.unitaryGroup n ℂ,
      γ 0 = 1 ∧ HasDerivAt (fun t => (γ t).val) A 0 := by
  constructor
  · intro hA
    exact ⟨unitaryExpCurve A hA, unitaryExpCurve_zero A hA,
      unitaryExpCurve_hasDerivAt_zero A hA⟩
  · rintro ⟨γ, hγ0, hγ⟩
    exact unitary_curve_derivative_skew γ hγ hγ0

end LogSobolev
